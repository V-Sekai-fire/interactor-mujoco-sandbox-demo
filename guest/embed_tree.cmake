# Embeds every file named in <dir>/FILES.txt into the guest: a C file whose assembly includes
# the bytes, and a header with one table of name, begin and end. The first row is the main model file.
function(embed_tree dir out_asm out_header)
	file(STRINGS "${dir}/FILES.txt" _files)
	set(_asm "__asm__(\"\\t.section .rodata\\n\"\n")
	set(_decl "")
	set(_rows "")
	set(_deps "${dir}/FILES.txt")
	set(_i 0)
	foreach(_f IN LISTS _files)
		string(APPEND _asm "\t\"\\t.balign 8\\n\\t.global human_file_${_i}\\nhuman_file_${_i}:\\n\\t.incbin \\\"${dir}/${_f}\\\"\\n\\t.global human_file_${_i}_end\\nhuman_file_${_i}_end:\\n\\t.byte 0\\n\"\n")
		string(APPEND _decl "extern const unsigned char human_file_${_i}[], human_file_${_i}_end[];\n")
		string(APPEND _rows "\t{ \"${_f}\", human_file_${_i}, human_file_${_i}_end },\n")
		list(APPEND _deps "${dir}/${_f}")
		math(EXPR _i "${_i} + 1")
	endforeach()
	file(WRITE "${out_asm}" "// Generated by guest/embed_tree.cmake from FILES.txt.\n${_asm}\t\"\\t.text\\n\");\n")
	file(WRITE "${out_header}" "// Generated by guest/embed_tree.cmake from FILES.txt.\n#pragma once\n\nextern \"C\" {\n${_decl}}\n\nstruct HumanFile {\n\tconst char *name;\n\tconst unsigned char *begin;\n\tconst unsigned char *end;\n};\n\nstatic const HumanFile HUMAN_FILES[] = {\n${_rows}};\nstatic const int HUMAN_FILE_COUNT = ${_i};\n")
	set_property(SOURCE "${out_asm}" PROPERTY OBJECT_DEPENDS "${_deps}")
	set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${dir}/FILES.txt")
endfunction()
